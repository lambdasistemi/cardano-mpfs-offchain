[19.174966, "o", "    \"token\": \"c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632\"\r\n  }\r\n}\r\n"]
[20.180634, "o", "\r\n# Requester submits a delete request; owner processing removes the fact, and fact get proves absence.\r\n"]
[20.18068, "o", "$ mpfs-cli --json fact delete --token c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 --key 6465766e65742d6c6966656379636c652d6d61696e --value 6465766e65742d76616c75652d7632 | jq '.'\r\n"]
