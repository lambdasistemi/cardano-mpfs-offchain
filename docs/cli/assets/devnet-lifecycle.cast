[62.135063, "o", "$ mpfs-cli --json requests list c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 | jq '{verified,result}'\r\n"]
[62.410026, "o", "{\r\n  \"verified\": true,\r\n  \"result\": {\r\n    \"requests\": [],\r\n    \"token\": \"c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632\"\r\n  }\r\n}\r\n"]
[63.415984, "o", "\r\n# With pending requests cleared, the owner ends the token; final token list is empty again.\r\n$ mpfs-cli --json token end --token c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 | jq '.'\r\n"]
[63.929016, "o", "{\r\n  \"command\": \"token end\",\r\n  \"status\": \"submitted\",\r\n  \"txId\": \"43d782f4f3a29842c93182d8b4e88c527b0f3d45deeb2aa59f14dbbb895f66be\"\r\n}\r\n"]
[64.937058, "o", "$ mpfs-cli --json token list | jq '{verified,result}'\r\n"]
[65.20685, "o", "{\r\n  \"verified\": true,\r\n  \"result\": {\r\n    \"tokens\": []\r\n  }\r\n}\r\n"]
[66.213145, "o", "\r\n# Lifecycle complete: register, insert/process/get, update/process/get, delete/process/absent, reject, retract, and end.\r\n"]
