[21.733734, "o", "$ mpfs-cli --json requests list c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 | jq '{verified,result}'\r\n"]
[22.004325, "o", "{\r\n  \"verified\": true,\r\n  \"result\": {\r\n    \"requests\": [\r\n      {\r\n        \"fee\": 1000000,\r\n        \"id\": \"00b7d5184252622334b75cf57051a7a407ec7a0ce69664330aff72681b9cb271#0\",\r\n        \"key\": \"6465766e65742d6c6966656379636c652d6d61696e\",\r\n        \"operation\": \"delete\",\r\n        \"owner\": \"f92331d882d35e05978c558352a66c61f476838e1e2fd1c4ae7fc0d6\",\r\n        \"processDeadline\": 1781076786592,\r\n        \"retractDeadline\": 1781076796592,\r\n        \"submittedAt\": 1781076781592,\r\n        \"value\": null\r\n      }\r\n    ],\r\n    \"token\": \"c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632\"\r\n  }\r\n}\r\n"]
