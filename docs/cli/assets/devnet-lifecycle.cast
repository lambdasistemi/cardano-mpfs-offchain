[49.436906, "o", "$ mpfs-cli --json requests list c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 | jq '{verified,result}'\r\n"]
[49.713103, "o", "{\r\n  \"verified\": true,\r\n  \"result\": {\r\n    \"requests\": [],\r\n    \"token\": \"c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632\"\r\n  }\r\n}\r\n"]
[50.719383, "o", "\r\n# Retract path: create a pending request, wait for the process window to expire, then retract that request id before the retract deadline.\r\n$ mpfs-cli --json fact insert --token c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 --key 6465766e65742d6c6966656379636c652d72657472616374 --value 6465766e65742d726574726163742d6d65 | jq '.'\r\n"]
[51.229202, "o", "{\r\n  \"command\": \"fact insert\",\r\n  \"status\": \"submitted\",\r\n  \"txId\": \"f8c546d0f8e90326924d818b03f970fa53aa725c57eab57b26c053c686de09a0\"\r\n}\r\n"]
[52.2357, "o", "$ mpfs-cli --json requests list c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 | jq '{verified,result}'\r\n"]
[52.508426, "o", "{\r\n  \"verified\": true,\r\n  \"result\": {\r\n    \"requests\": [\r\n      {\r\n        \"fee\": 1000000,\r\n        \"id\": \"f8c546d0f8e90326924d818b03f970fa53aa725c57eab57b26c053c686de09a0#0\",\r\n        \"key\": \"6465766e65742d6c6966656379636c652d72657472616374\",\r\n        \"operation\": \"insert\",\r\n        \"owner\": \"f92331d882d35e05978c558352a66c61f476838e1e2fd1c4ae7fc0d6\",\r\n        \"processDeadline\": 1781076817133,\r\n        \"retractDeadline\": 1781076827133,\r\n        \"submittedAt\": 1781076812133,\r\n        \"value\": \"6465766e65742d726574726163742d6d65\"\r\n      }\r\n    ],\r\n    \"token\": \"c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632\"\r\n  }\r\n}\r\n"]
[53.516061, "o", "# REQUEST_ID=f8c546d0f8e90326924d818b03f970fa53aa725c57eab57b26c053c686de09a0#0\r\n$ sleep 7\r\n"]
