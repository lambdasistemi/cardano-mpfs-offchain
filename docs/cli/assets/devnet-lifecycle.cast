[29.913516, "o", "$ sleep 18\r\n"]
[47.915865, "o", "$ mpfs-cli --json fact reject --token c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 | jq '.'\r\n"]
