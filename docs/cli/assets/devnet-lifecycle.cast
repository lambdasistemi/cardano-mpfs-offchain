[24.808874, "o", "{\r\n  \"verified\": true,\r\n  \"result\": {\r\n    \"key\": \"6465766e65742d6c6966656379636c652d6d61696e\",\r\n    \"present\": false,\r\n    \"token\": \"c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632\"\r\n  }\r\n}\r\n"]
[25.814064, "o", "$ mpfs-cli --json fact list c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 | jq '{verified,result}'\r\n"]
[26.078921, "o", "{\r\n  \"verified\": true,\r\n  \"result\": {\r\n    \"facts\": [],\r\n    \"token\": \"c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632\"\r\n  }\r\n}\r\n"]
[27.084617, "o", "\r\n# Reject path: create a pending request, wait past the short process and retract deadlines, then owner rejects it.\r\n$ mpfs-cli --json fact insert --token c1f1c9b09607e0f63d1580f3e9d3eb88b7d8a208f5a3d4be01b8fd009eebb632 --key 6465766e65742d6c6966656379636c652d72656a656374 --value 6465766e65742d72656a6563742d6d65 | jq '.'\r\n"]
