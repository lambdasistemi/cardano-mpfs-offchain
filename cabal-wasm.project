-- WASM (wasm32-wasi) / GHC-JS build configuration for the pure MPFS
-- verifier and cage transaction builders. Self-contained: only
-- cardano-mpfs-verify, cardano-mpfs-cage-tx, and cardano-mpfs-api are in
-- the package set, so the solver never touches cardano-mpfs-client's
-- IO main library (http-client, servant-client, cardano-node-clients,
-- rocksdb). Fork overrides + index-state mirror nix/wasm/forks.json; the
-- source-repository-package stanzas below are pre-fetched and rewritten to
-- local store paths by mkCardanoLedgerWasm (srpForks).

repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

active-repositories:
  , :rest
  , cardano-haskell-packages:override

allow-newer: *:template-haskell, *:base, *:deepseq, *:ghc-prim, *:time, *:text
-- The wasm GHC ships containers 0.7; mts caps it <0.7 (mirrors the same
-- allow-newer in cabal.project for the native build).
allow-newer: mts:containers

-- hackage pinned to the truncated index's latest entry (the FOD builds
-- the index at forks.json indexState 2026-04-15, whose newest revision is
-- 2026-04-14T23:46:27Z); requesting a later instant trips Cabal-7159.
index-state:
  , hackage.haskell.org 2026-04-14T23:46:27Z
  , cardano-haskell-packages 2026-05-25T13:25:40Z

packages:
  cardano-mpfs-verify/
  cardano-mpfs-cage-tx/
  cardano-mpfs-api/

-- Package flags mirrored from nix/wasm/forks.json.
package cardano-crypto-praos
  flags: -external-libsodium-vrf

package crypton
  ghc-options: -optc-DARGON2_NO_THREADS

package atomic-counter
  flags: +no-cmm

package digest
  flags: -pkg-config

package plutus-core
  flags: +do-not-build-plutus-exec

package cardano-tx-tools
  flags: -build-node-tools

package mts
  flags: +wasm

-- SRP entries pre-fetched and rewritten by mkCardanoLedgerWasm at build time
-- via srpForks. Listed here so the solver's first pass has the versions.
source-repository-package
  type: git
  location: https://github.com/amesgen/cborg
  tag: 2dff24d241d9940c5a7f5e817fcf4c1aa4a8d4bf
  subdir: cborg

source-repository-package
  type: git
  location: https://github.com/intersectmbo/plutus.git
  tag: d1684df33d1b7226dfa5f2247aa67a46c2d5453b
  subdir:
    plutus-core
    plutus-ledger-api
    plutus-tx

source-repository-package
  type: git
  location: https://github.com/haskell-wasm/hs-memory.git
  tag: a198a76c584dc2cfdcde6b431968de92a5fed65e

source-repository-package
  type: git
  location: https://github.com/Jimbo4350/foundation.git
  tag: b3cb78484fe6f6ce1dfcef59e72ceccc530e86ac
  subdir:
    basement
