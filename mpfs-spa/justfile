# mpfs-spa task runner — all recipes assume `nix develop` (purescript shell).

# Compile PureScript.
build:
    spago build

# Bundle the browser app into dist/index.js (esbuild resolves npm deps).
bundle:
    spago bundle --module Main --outfile dist/index.js

# Watch-rebuild for local development.
dev:
    spago build --watch

# Run the unit test suite.
test:
    spago test

# Apply formatting in place.
format:
    purs-tidy format-in-place 'src/**/*.purs' 'test/**/*.purs'

# Fail if any source is unformatted.
lint:
    purs-tidy check 'src/**/*.purs' 'test/**/*.purs'

# Install npm deps from the committed lockfile.
install:
    npm ci

# Local CI mirror.
ci: install lint build test bundle
